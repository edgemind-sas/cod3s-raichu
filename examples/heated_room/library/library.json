{
  "raichu_library": {
    "format": 1
  },
  "library": {
    "name": "heated_room",
    "version": "1.0.0",
    "description": "The heated room example as a component type library: a heater with a thermostat that can fail, and a room losing heat to a daily-varying outside.",
    "types": [
      {
        "name": "Heater",
        "description": "An electric heater with a thermostat: it heats while its thermostat is on and it works. It reads the room temperature through `temperature_in` and delivers its heating rate on `power_out`.",
        "parameters": [
          {
            "name": "on_below",
            "kind": "number",
            "description": "Thermostat switches on below this temperature, in °C."
          },
          {
            "name": "off_above",
            "kind": "number",
            "description": "Thermostat switches off above this temperature, in °C."
          },
          {
            "name": "running",
            "kind": "bool",
            "description": "Whether the thermostat is on at the start."
          },
          {
            "name": "power",
            "kind": "number",
            "default": 3.0,
            "description": "Heating rate delivered while running, in °C/h."
          },
          {
            "name": "failure_rate",
            "kind": "number",
            "default": 0.002,
            "description": "Failure rate, in 1/h."
          },
          {
            "name": "repair_rate",
            "kind": "number",
            "default": 0.041666666666666664,
            "description": "Repair rate, in 1/h."
          }
        ],
        "body": {
          "attributes": [
            {
              "name": "power",
              "kind": "float",
              "init": {
                "kind": "float",
                "value": {
                  "$choose": "running",
                  "cases": {
                    "true": {
                      "$param": "power"
                    },
                    "false": 0.0
                  }
                }
              }
            }
          ],
          "ports": [
            {
              "name": "power_out",
              "dir": "out",
              "attr": "power"
            },
            {
              "name": "temperature_in",
              "dir": "in"
            }
          ],
          "automata": [
            {
              "name": "thermostat",
              "states": [
                "on",
                "off"
              ],
              "init": {
                "$choose": "running",
                "cases": {
                  "true": "on",
                  "false": "off"
                }
              },
              "transitions": [
                {
                  "name": "switch_off",
                  "source": "on",
                  "targets": [
                    "off"
                  ],
                  "guard": {
                    "op": "cmp",
                    "cmp": "gt",
                    "lhs": {
                      "op": "port_agg",
                      "port": {
                        "component": "$self",
                        "port": "temperature_in"
                      },
                      "agg": "sum"
                    },
                    "rhs": {
                      "op": "const",
                      "value": {
                        "kind": "float",
                        "value": {
                          "$param": "off_above"
                        }
                      }
                    }
                  },
                  "distrib": "watched"
                },
                {
                  "name": "switch_on",
                  "source": "off",
                  "targets": [
                    "on"
                  ],
                  "guard": {
                    "op": "cmp",
                    "cmp": "lt",
                    "lhs": {
                      "op": "port_agg",
                      "port": {
                        "component": "$self",
                        "port": "temperature_in"
                      },
                      "agg": "sum"
                    },
                    "rhs": {
                      "op": "const",
                      "value": {
                        "kind": "float",
                        "value": {
                          "$param": "on_below"
                        }
                      }
                    }
                  },
                  "distrib": "watched"
                }
              ]
            },
            {
              "name": "health",
              "states": [
                "ok",
                "failed"
              ],
              "init": "ok",
              "transitions": [
                {
                  "name": "fail",
                  "source": "ok",
                  "targets": [
                    "failed"
                  ],
                  "distrib": "exp",
                  "rate": {
                    "$param": "failure_rate"
                  },
                  "monitored": true,
                  "cycle_group": "$self"
                },
                {
                  "name": "repair",
                  "source": "failed",
                  "targets": [
                    "ok"
                  ],
                  "distrib": "exp",
                  "rate": {
                    "$param": "repair_rate"
                  },
                  "monitored": true,
                  "cycle_group": "$self"
                }
              ]
            }
          ],
          "sensitive_functions": [
            {
              "name": "update_power",
              "effects": [
                {
                  "target": {
                    "component": "$self",
                    "attribute": "power"
                  },
                  "value": {
                    "op": "if",
                    "cond": {
                      "op": "bool",
                      "bool_op": "and",
                      "args": [
                        {
                          "op": "state_active",
                          "state": {
                            "component": "$self",
                            "automaton": "thermostat",
                            "state": "on"
                          }
                        },
                        {
                          "op": "state_active",
                          "state": {
                            "component": "$self",
                            "automaton": "health",
                            "state": "ok"
                          }
                        }
                      ]
                    },
                    "then": {
                      "op": "const",
                      "value": {
                        "kind": "float",
                        "value": {
                          "$param": "power"
                        }
                      }
                    },
                    "otherwise": {
                      "op": "const",
                      "value": {
                        "kind": "float",
                        "value": 0.0
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "name": "Room",
        "description": "A room losing heat to a daily-varying outside temperature and warmed by whatever its `power_in` receives. It publishes its temperature on `temperature_out`, and freezes below `frozen_below` until it warms back above `thawed_above`.",
        "parameters": [
          {
            "name": "temperature_init",
            "kind": "number",
            "default": 20.0,
            "description": "Initial temperature, in °C."
          },
          {
            "name": "loss",
            "kind": "number",
            "default": 0.1,
            "description": "Relaxation rate to the outside, in 1/h."
          },
          {
            "name": "outside_mean",
            "kind": "number",
            "description": "Mean outside temperature, in °C."
          },
          {
            "name": "outside_amplitude",
            "kind": "number",
            "description": "Amplitude of the daily outside variation, in °C."
          },
          {
            "name": "outside_omega",
            "kind": "number",
            "default": 0.2617993877991494,
            "description": "Angular frequency of the daily variation, 2π/24 per hour."
          },
          {
            "name": "outside_phase",
            "kind": "number",
            "description": "Time shift of the sine, in hours: the hour of the daily peak minus 6."
          },
          {
            "name": "frozen_below",
            "kind": "number",
            "default": 10.0,
            "description": "The room freezes below this temperature, in °C."
          },
          {
            "name": "thawed_above",
            "kind": "number",
            "default": 12.0,
            "description": "A frozen room thaws above this temperature, in °C."
          }
        ],
        "body": {
          "attributes": [
            {
              "name": "temperature",
              "kind": "float",
              "init": {
                "kind": "float",
                "value": {
                  "$param": "temperature_init"
                }
              }
            }
          ],
          "ports": [
            {
              "name": "power_in",
              "dir": "in"
            },
            {
              "name": "temperature_out",
              "dir": "out",
              "attr": "temperature"
            }
          ],
          "automata": [
            {
              "name": "comfort",
              "states": [
                "ok",
                "frozen"
              ],
              "init": "ok",
              "transitions": [
                {
                  "name": "freeze",
                  "source": "ok",
                  "targets": [
                    "frozen"
                  ],
                  "guard": {
                    "op": "cmp",
                    "cmp": "lt",
                    "lhs": {
                      "op": "attr",
                      "attr": {
                        "component": "$self",
                        "attribute": "temperature"
                      }
                    },
                    "rhs": {
                      "op": "const",
                      "value": {
                        "kind": "float",
                        "value": {
                          "$param": "frozen_below"
                        }
                      }
                    }
                  },
                  "distrib": "watched"
                },
                {
                  "name": "thaw",
                  "source": "frozen",
                  "targets": [
                    "ok"
                  ],
                  "guard": {
                    "op": "cmp",
                    "cmp": "gt",
                    "lhs": {
                      "op": "attr",
                      "attr": {
                        "component": "$self",
                        "attribute": "temperature"
                      }
                    },
                    "rhs": {
                      "op": "const",
                      "value": {
                        "kind": "float",
                        "value": {
                          "$param": "thawed_above"
                        }
                      }
                    }
                  },
                  "distrib": "watched"
                }
              ]
            }
          ],
          "equations": [
            {
              "target": "temperature",
              "kind": "ode",
              "expr": {
                "op": "sub",
                "lhs": {
                  "op": "port_agg",
                  "port": {
                    "component": "$self",
                    "port": "power_in"
                  },
                  "agg": "sum"
                },
                "rhs": {
                  "op": "mul",
                  "args": [
                    {
                      "op": "const",
                      "value": {
                        "kind": "float",
                        "value": {
                          "$param": "loss"
                        }
                      }
                    },
                    {
                      "op": "sub",
                      "lhs": {
                        "op": "attr",
                        "attr": {
                          "component": "$self",
                          "attribute": "temperature"
                        }
                      },
                      "rhs": {
                        "op": "add",
                        "args": [
                          {
                            "op": "const",
                            "value": {
                              "kind": "float",
                              "value": {
                                "$param": "outside_mean"
                              }
                            }
                          },
                          {
                            "op": "mul",
                            "args": [
                              {
                                "op": "const",
                                "value": {
                                  "kind": "float",
                                  "value": {
                                    "$param": "outside_amplitude"
                                  }
                                }
                              },
                              {
                                "op": "sin",
                                "arg": {
                                  "op": "mul",
                                  "args": [
                                    {
                                      "op": "const",
                                      "value": {
                                        "kind": "float",
                                        "value": {
                                          "$param": "outside_omega"
                                        }
                                      }
                                    },
                                    {
                                      "op": "sub",
                                      "lhs": {
                                        "op": "time"
                                      },
                                      "rhs": {
                                        "op": "const",
                                        "value": {
                                          "kind": "float",
                                          "value": {
                                            "$param": "outside_phase"
                                          }
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  }
}
