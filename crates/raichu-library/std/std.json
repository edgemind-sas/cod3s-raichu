{
  "raichu_library": {
    "format": 1
  },
  "library": {
    "name": "std",
    "version": "engine",
    "description": "The standard fragments shipped with RAICHU, written in the library format itself. Its version is the engine's: a standard fragment changes with the engine, and the expanded model records the engine version that supplied it.",
    "fragments": [
      {
        "name": "bool_flow_in",
        "description": "A boolean input flow `<name>`: an in port `<name>_in` and the attribute `<name>_fed_in`, true while the connected sources feed it under `logic`.",
        "parameters": [
          {
            "name": "name",
            "kind": "string",
            "description": "Flow name."
          },
          {
            "name": "logic",
            "kind": "enum",
            "values": [
              "and",
              "or",
              "k"
            ],
            "default": "and",
            "description": "How the connected sources combine: all of them (and), any of them (or), or at least k of them (k). An input nothing feeds reads its default under every logic."
          },
          {
            "name": "k",
            "kind": "integer",
            "default": 1,
            "description": "The k of a k-out-of-n input."
          },
          {
            "name": "default",
            "kind": "bool",
            "default": false,
            "description": "What the input reads while no connection feeds it."
          }
        ],
        "body": {
          "attributes": [
            {
              "name": "${name}_fed_in",
              "kind": "bool",
              "init": {
                "kind": "bool",
                "value": {
                  "$param": "default"
                }
              }
            }
          ],
          "ports": [
            {
              "name": "${name}_in",
              "dir": "in"
            }
          ],
          "sensitive_functions": [
            {
              "name": "update_${name}_fed_in",
              "effects": [
                {
                  "target": {
                    "component": "$self",
                    "attribute": "${name}_fed_in"
                  },
                  "value": {
                    "$choose": "default",
                    "cases": {
                      "false": {
                        "$choose": "logic",
                        "cases": {
                          "or": {
                            "op": "port_agg",
                            "port": {
                              "component": "$self",
                              "port": "${name}_in"
                            },
                            "agg": "any"
                          },
                          "and": {
                            "op": "bool",
                            "bool_op": "and",
                            "args": [
                              {
                                "op": "port_agg",
                                "port": {
                                  "component": "$self",
                                  "port": "${name}_in"
                                },
                                "agg": "all"
                              },
                              {
                                "op": "cmp",
                                "cmp": "ge",
                                "lhs": {
                                  "op": "port_agg",
                                  "port": {
                                    "component": "$self",
                                    "port": "${name}_in"
                                  },
                                  "agg": "count"
                                },
                                "rhs": {
                                  "op": "const",
                                  "value": {
                                    "kind": "int",
                                    "value": 1
                                  }
                                }
                              }
                            ]
                          },
                          "k": {
                            "op": "bool",
                            "bool_op": "and",
                            "args": [
                              {
                                "op": "cmp",
                                "cmp": "ge",
                                "lhs": {
                                  "op": "port_agg",
                                  "port": {
                                    "component": "$self",
                                    "port": "${name}_in"
                                  },
                                  "agg": "sum"
                                },
                                "rhs": {
                                  "op": "const",
                                  "value": {
                                    "kind": "int",
                                    "value": {
                                      "$param": "k"
                                    }
                                  }
                                }
                              },
                              {
                                "op": "cmp",
                                "cmp": "ge",
                                "lhs": {
                                  "op": "port_agg",
                                  "port": {
                                    "component": "$self",
                                    "port": "${name}_in"
                                  },
                                  "agg": "count"
                                },
                                "rhs": {
                                  "op": "const",
                                  "value": {
                                    "kind": "int",
                                    "value": 1
                                  }
                                }
                              }
                            ]
                          }
                        }
                      },
                      "true": {
                        "op": "bool",
                        "bool_op": "or",
                        "args": [
                          {
                            "$choose": "logic",
                            "cases": {
                              "or": {
                                "op": "port_agg",
                                "port": {
                                  "component": "$self",
                                  "port": "${name}_in"
                                },
                                "agg": "any"
                              },
                              "and": {
                                "op": "bool",
                                "bool_op": "and",
                                "args": [
                                  {
                                    "op": "port_agg",
                                    "port": {
                                      "component": "$self",
                                      "port": "${name}_in"
                                    },
                                    "agg": "all"
                                  },
                                  {
                                    "op": "cmp",
                                    "cmp": "ge",
                                    "lhs": {
                                      "op": "port_agg",
                                      "port": {
                                        "component": "$self",
                                        "port": "${name}_in"
                                      },
                                      "agg": "count"
                                    },
                                    "rhs": {
                                      "op": "const",
                                      "value": {
                                        "kind": "int",
                                        "value": 1
                                      }
                                    }
                                  }
                                ]
                              },
                              "k": {
                                "op": "bool",
                                "bool_op": "and",
                                "args": [
                                  {
                                    "op": "cmp",
                                    "cmp": "ge",
                                    "lhs": {
                                      "op": "port_agg",
                                      "port": {
                                        "component": "$self",
                                        "port": "${name}_in"
                                      },
                                      "agg": "sum"
                                    },
                                    "rhs": {
                                      "op": "const",
                                      "value": {
                                        "kind": "int",
                                        "value": {
                                          "$param": "k"
                                        }
                                      }
                                    }
                                  },
                                  {
                                    "op": "cmp",
                                    "cmp": "ge",
                                    "lhs": {
                                      "op": "port_agg",
                                      "port": {
                                        "component": "$self",
                                        "port": "${name}_in"
                                      },
                                      "agg": "count"
                                    },
                                    "rhs": {
                                      "op": "const",
                                      "value": {
                                        "kind": "int",
                                        "value": 1
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          },
                          {
                            "op": "bool",
                            "bool_op": "not",
                            "args": [
                              {
                                "op": "cmp",
                                "cmp": "ge",
                                "lhs": {
                                  "op": "port_agg",
                                  "port": {
                                    "component": "$self",
                                    "port": "${name}_in"
                                  },
                                  "agg": "count"
                                },
                                "rhs": {
                                  "op": "const",
                                  "value": {
                                    "kind": "int",
                                    "value": 1
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "name": "bool_flow_out",
        "description": "A boolean output flow `<name>` produced under a condition: `<name>_fed_out` is true while the production condition holds and the output is available. The condition is a disjunction of conjunctions: a list of groups, each a list of attribute names of the instance, and the output is produced while every attribute of at least one group is true. `<name>_fed_available_out` is written by the modes only: a mode cuts it when it starts available, and wakes it when it starts unavailable.",
        "parameters": [
          {
            "name": "name",
            "kind": "string",
            "description": "Flow name."
          },
          {
            "name": "prod_cond",
            "kind": "list",
            "items": "string_list",
            "description": "Production condition: any of these groups, each all of its attributes (for example [[\"power_fed_in\"]])."
          },
          {
            "name": "fed_available_init",
            "kind": "bool",
            "default": true,
            "description": "Whether the output starts available. A dormant service output starts unavailable and a compromise mode wakes it."
          }
        ],
        "body": {
          "attributes": [
            {
              "name": "${name}_fed_out",
              "kind": "bool",
              "init": {
                "kind": "bool",
                "value": false
              }
            },
            {
              "name": "${name}_fed_available_out",
              "kind": "bool",
              "init": {
                "kind": "bool",
                "value": {
                  "$param": "fed_available_init"
                }
              }
            },
            {
              "name": "${name}_prod_available",
              "kind": "bool",
              "init": {
                "kind": "bool",
                "value": true
              }
            }
          ],
          "ports": [
            {
              "name": "${name}_out",
              "dir": "out",
              "attr": "${name}_fed_out"
            }
          ],
          "sensitive_functions": [
            {
              "name": "update_${name}_prod_available",
              "effects": [
                {
                  "target": {
                    "component": "$self",
                    "attribute": "${name}_prod_available"
                  },
                  "value": {
                    "op": "bool",
                    "bool_op": "or",
                    "args": [
                      {
                        "$for_each": "prod_cond",
                        "as": "group",
                        "items": [
                          {
                            "op": "bool",
                            "bool_op": "and",
                            "args": [
                              {
                                "$for_each": "group",
                                "as": "operand",
                                "items": [
                                  {
                                    "op": "attr",
                                    "attr": {
                                      "component": "$self",
                                      "attribute": "${operand}"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "update_${name}_fed_out",
              "effects": [
                {
                  "target": {
                    "component": "$self",
                    "attribute": "${name}_fed_out"
                  },
                  "value": {
                    "op": "bool",
                    "bool_op": "and",
                    "args": [
                      {
                        "op": "attr",
                        "attr": {
                          "component": "$self",
                          "attribute": "${name}_prod_available"
                        }
                      },
                      {
                        "op": "attr",
                        "attr": {
                          "component": "$self",
                          "attribute": "${name}_fed_available_out"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "targetable": [
          {
            "attribute": "${name}_fed_available_out",
            "rule": {
              "$choose": "fed_available_init",
              "cases": {
                "true": "any_cuts",
                "false": "any_activates"
              }
            }
          }
        ]
      },
      {
        "name": "bool_source_out",
        "description": "A boolean output flow `<name>` with no production condition: a constant source, or a dormant function when `prod_init` is false. Nothing in the type writes `<name>_prod_available`, so a mode may activate (or cut) it.",
        "parameters": [
          {
            "name": "name",
            "kind": "string",
            "description": "Flow name."
          },
          {
            "name": "prod_init",
            "kind": "bool",
            "default": true,
            "description": "Whether the source produces from the start."
          },
          {
            "name": "fed_available_init",
            "kind": "bool",
            "default": true,
            "description": "Whether the output starts available."
          }
        ],
        "body": {
          "attributes": [
            {
              "name": "${name}_fed_out",
              "kind": "bool",
              "init": {
                "kind": "bool",
                "value": false
              }
            },
            {
              "name": "${name}_fed_available_out",
              "kind": "bool",
              "init": {
                "kind": "bool",
                "value": {
                  "$param": "fed_available_init"
                }
              }
            },
            {
              "name": "${name}_prod_available",
              "kind": "bool",
              "init": {
                "kind": "bool",
                "value": {
                  "$param": "prod_init"
                }
              }
            }
          ],
          "ports": [
            {
              "name": "${name}_out",
              "dir": "out",
              "attr": "${name}_fed_out"
            }
          ],
          "sensitive_functions": [
            {
              "name": "update_${name}_fed_out",
              "effects": [
                {
                  "target": {
                    "component": "$self",
                    "attribute": "${name}_fed_out"
                  },
                  "value": {
                    "op": "bool",
                    "bool_op": "and",
                    "args": [
                      {
                        "op": "attr",
                        "attr": {
                          "component": "$self",
                          "attribute": "${name}_prod_available"
                        }
                      },
                      {
                        "op": "attr",
                        "attr": {
                          "component": "$self",
                          "attribute": "${name}_fed_available_out"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "targetable": [
          {
            "attribute": "${name}_fed_available_out",
            "rule": {
              "$choose": "fed_available_init",
              "cases": {
                "true": "any_cuts",
                "false": "any_activates"
              }
            }
          },
          {
            "attribute": "${name}_prod_available",
            "rule": {
              "$choose": "prod_init",
              "cases": {
                "true": "any_cuts",
                "false": "any_activates"
              }
            }
          }
        ]
      },
      {
        "name": "logic_gate",
        "description": "A logic gate `<name>`: a boolean input combining its sources under `logic`, re-exported on the out port `<name>_out`.",
        "parameters": [
          {
            "name": "name",
            "kind": "string",
            "description": "Gate name."
          },
          {
            "name": "logic",
            "kind": "enum",
            "values": [
              "and",
              "or",
              "k"
            ],
            "default": "and",
            "description": "How the connected sources combine: all of them (and), any of them (or), or at least k of them (k). An input nothing feeds reads its default under every logic."
          },
          {
            "name": "k",
            "kind": "integer",
            "default": 1,
            "description": "The k of a k-out-of-n input."
          },
          {
            "name": "default",
            "kind": "bool",
            "default": false,
            "description": "What the input reads while no connection feeds it."
          }
        ],
        "uses": [
          {
            "fragment": "bool_flow_in",
            "with": {
              "name": "${name}",
              "logic": {
                "$param": "logic"
              },
              "k": {
                "$param": "k"
              },
              "default": {
                "$param": "default"
              }
            }
          }
        ],
        "body": {
          "ports": [
            {
              "name": "${name}_out",
              "dir": "out",
              "attr": "${name}_fed_in"
            }
          ]
        }
      }
    ]
  }
}
